# .env.example
# 실제 설정값을 담는 .env 파일의 견본. 이 파일을 .env 로 복사한 뒤 값을 채워 쓴다.
#   cp .env.example .env
# 위치는 프로젝트 루트(myapp/)다. app/ 안이 아니다.
# .env 에는 비밀번호가 들어가므로 절대 git 에 커밋하지 않는다(.gitignore 에 등록되어 있음).

# 사용할 설정 이름: development / testing / production
FLASK_CONFIG=development

# session, flash 서명에 쓰이는 키. 운영에서는 아래 명령으로 만든 무작위 값을 넣는다.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-me

# --- DB 접속 정보 (항목별로 지정하는 방식) ---
DB_DRIVER=postgresql+psycopg
DB_USER=flask_user
DB_PASSWORD=flask_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flask_app

# --- DB 접속 정보 (한 줄로 지정하는 방식) ---
# 이 값이 있으면 위의 DB_* 항목들보다 우선한다. 클라우드 서비스가 주로 이 형태를 준다.
# DATABASE_URL=postgresql+psycopg://flask_user:flask_password@localhost:5432/flask_app

# --- AI 에이전트 (Anthropic Claude) ---
# https://console.anthropic.com 에서 발급받은 키를 넣는다. 절대 커밋하지 않는다.
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-opus-5
AGENT_MAX_TOKENS=16000
# low / medium / high / xhigh / max
AGENT_EFFORT=medium

# 호출 경로 스위치: claude_api (기본) 또는 bedrock
AGENT_PROVIDER=claude_api
# 안전 분류기가 거절했을 때 대신 시도할 모델 (접두사 없이 짧은 이름으로 적는다)
AGENT_FALLBACK_MODEL=claude-opus-4-8

# --- AGENT_PROVIDER=bedrock 일 때만 필요 ---
# 리전은 필수. 해당 리전에서 Bedrock 모델 액세스를 먼저 켜둬야 한다.
AWS_REGION=us-east-1
# 아래 키들을 비워두면 ~/.aws/credentials 나 IAM 역할에서 자동으로 찾는다.
# EC2/ECS 위에서 돌린다면 키를 넣지 말고 IAM 역할을 쓰는 편이 안전하다.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=

# --- 알람 / Lambda ---
# local = AWS 없이 핸들러를 직접 실행 (개발/학습용) / aws = 실제 Lambda 호출
LAMBDA_MODE=local
LAMBDA_FUNCTION_NAME=flask-app-normalize-event
# RequestResponse(동기, 결과를 화면에 표시) / Event(비동기, 결과는 CloudWatch)
LAMBDA_INVOCATION_TYPE=RequestResponse
# 관리자 계정 (콤마로 여러 명)
ADMIN_USERS=admin

# --- Lambda 함수 쪽 환경변수 (AWS 콘솔/IaC 에서 설정) ---
# 정규화한 이벤트를 넣을 DB. 없으면 적재를 건너뛴다.
# DATABASE_URL=postgresql://user:pw@host:5432/db
# critical/error 이벤트를 발송할 SNS 토픽. 없으면 알람을 건너뛴다.
# ALARM_SNS_TOPIC_ARN=arn:aws:sns:ap-northeast-2:123456789012:app-alarms

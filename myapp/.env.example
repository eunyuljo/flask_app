# .env.example
# 실제 설정값을 담는 .env 파일의 견본. 이 파일을 .env 로 복사한 뒤 값을 채워 쓴다.
#   cp .env.example .env
# .env 에는 비밀번호가 들어가므로 절대 git 에 커밋하지 않는다(.gitignore 에 등록되어 있음).

# 사용할 설정 이름: development / testing / production
FLASK_CONFIG=development

# session, flash 서명에 쓰이는 키. 운영에서는 아래 명령으로 만든 무작위 값을 넣는다.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-me

# --- DB 접속 정보 (항목별로 지정하는 방식) ---
DB_DRIVER=postgresql+psycopg
DB_USER=flask_user
DB_PASSWORD=flask_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flask_app

# --- DB 접속 정보 (한 줄로 지정하는 방식) ---
# 이 값이 있으면 위의 DB_* 항목들보다 우선한다. 클라우드 서비스가 주로 이 형태를 준다.
# DATABASE_URL=postgresql+psycopg://flask_user:flask_password@localhost:5432/flask_app

# --- AI 에이전트 (Anthropic Claude) ---
# https://console.anthropic.com 에서 발급받은 키를 넣는다. 절대 커밋하지 않는다.
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-opus-5
AGENT_MAX_TOKENS=16000
# low / medium / high / xhigh / max
AGENT_EFFORT=medium
